<library>
<description>&lt;b&gt;Waveshare ESP32-S3-Zero Microcontroller Board&lt;/b&gt;&lt;br&gt;
Compact ESP32-S3FH4R2 Development Module with Castellated Edge Pads.&lt;br&gt;
Dimensions: 23.5mm x 18.0mm, Pitch: 2.54mm (0.1 inch).&lt;br&gt;
Includes 4MB Flash, 2MB PSRAM, USB Type-C, WS2812 RGB LED.&lt;br&gt;&lt;br&gt;
&lt;author&gt;Created for Antigravity User&lt;/author&gt;</description>
<packages>
<package name="ESP32-S3-ZERO-TH">
<description>&lt;b&gt;Waveshare ESP32-S3-Zero (Through-Hole Headers)&lt;/b&gt;&lt;br&gt;
Dimensions: 23.5mm x 18.0mm. Pin pitch: 2.54mm.</description>
<wire xval1="-9.0" yval1="11.75" xval2="9.0" yval2="11.75" width="0.127" layer="21"/>
<wire xval1="9.0" yval1="11.75" xval2="9.0" yval2="-11.75" width="0.127" layer="21"/>
<wire xval1="9.0" yval1="-11.75" xval2="-9.0" yval2="-11.75" width="0.127" layer="21"/>
<wire xval1="-9.0" yval1="-11.75" xval2="-9.0" yval2="11.75" width="0.127" layer="21"/>
<!-- USB-C Outline -->
<wire xval1="-4.5" yval1="11.75" xval2="-4.5" yval2="7.25" width="0.127" layer="51"/>
<wire xval1="-4.5" yval1="7.25" xval2="4.5" yval2="7.25" width="0.127" layer="51"/>
<wire xval1="4.5" yval1="7.25" xval2="4.5" yval2="11.75" width="0.127" layer="51"/>
<text x="-9.0" y="12.5" size="1.27" layer="25">&gt;NAME</text>
<text x="-9.0" y="-14.0" size="1.27" layer="27">&gt;VALUE</text>
<!-- Pin 1 Marker -->
<circle x="-7.62" y="10.16" radius="0.4" width="0.8" layer="21"/>
<!-- Left Row (Pins 1-9) -->
<pad name="1" x="-7.62" y="10.16" drill="1.0" shape="square"/>
<pad name="2" x="-7.62" y="7.62" drill="1.0"/>
<pad name="3" x="-7.62" y="5.08" drill="1.0"/>
<pad name="4" x="-7.62" y="2.54" drill="1.0"/>
<pad name="5" x="-7.62" y="0.0" drill="1.0"/>
<pad name="6" x="-7.62" y="-2.54" drill="1.0"/>
<pad name="7" x="-7.62" y="-5.08" drill="1.0"/>
<pad name="8" x="-7.62" y="-7.62" drill="1.0"/>
<pad name="9" x="-7.62" y="-10.16" drill="1.0"/>
<!-- Right Row (Pins 10-18) -->
<pad name="10" x="7.62" y="-10.16" drill="1.0"/>
<pad name="11" x="7.62" y="-7.62" drill="1.0"/>
<pad name="12" x="7.62" y="-5.08" drill="1.0"/>
<pad name="13" x="7.62" y="-2.54" drill="1.0"/>
<pad name="14" x="7.62" y="0.0" drill="1.0"/>
<pad name="15" x="7.62" y="2.54" drill="1.0"/>
<pad name="16" x="7.62" y="5.08" drill="1.0"/>
<pad name="17" x="7.62" y="7.62" drill="1.0"/>
<pad name="18" x="7.62" y="10.16" drill="1.0"/>
<!-- Bottom Row (Pins 19-27) -->
<pad name="19" x="-5.08" y="-10.16" drill="1.0"/>
<pad name="20" x="-3.81" y="-10.16" drill="1.0"/>
<pad name="21" x="-2.54" y="-10.16" drill="1.0"/>
<pad name="22" x="-1.27" y="-10.16" drill="1.0"/>
<pad name="23" x="0.0" y="-10.16" drill="1.0"/>
<pad name="24" x="1.27" y="-10.16" drill="1.0"/>
<pad name="25" x="2.54" y="-10.16" drill="1.0"/>
<pad name="26" x="3.81" y="-10.16" drill="1.0"/>
<pad name="27" x="5.08" y="-10.16" drill="1.0"/>
<!-- Extra UART Pads -->
<pad name="43" x="-2.54" y="5.08" drill="0.8"/>
<pad name="44" x="-2.54" y="2.54" drill="0.8"/>
</package>

<package name="ESP32-S3-ZERO-SMD">
<description>&lt;b&gt;Waveshare ESP32-S3-Zero (Castellated Surface Mount Pads)&lt;/b&gt;&lt;br&gt;
Surface mount footprint for direct PCB soldering onto carrier board.</description>
<wire xval1="-9.0" yval1="11.75" xval2="9.0" yval2="11.75" width="0.127" layer="21"/>
<wire xval1="9.0" yval1="11.75" xval2="9.0" yval2="-11.75" width="0.127" layer="21"/>
<wire xval1="9.0" yval1="-11.75" xval2="-9.0" yval2="-11.75" width="0.127" layer="21"/>
<wire xval1="-9.0" yval1="-11.75" xval2="-9.0" yval2="11.75" width="0.127" layer="21"/>
<text x="-9.0" y="12.5" size="1.27" layer="25">&gt;NAME</text>
<text x="-9.0" y="-14.0" size="1.27" layer="27">&gt;VALUE</text>
<circle x="-7.5" y="10.16" radius="0.4" width="0.8" layer="21"/>
<!-- Left Castellated Pads -->
<smd name="1" x="-8.5" y="10.16" dx="2.0" dy="1.4" layer="1"/>
<smd name="2" x="-8.5" y="7.62" dx="2.0" dy="1.4" layer="1"/>
<smd name="3" x="-8.5" y="5.08" dx="2.0" dy="1.4" layer="1"/>
<smd name="4" x="-8.5" y="2.54" dx="2.0" dy="1.4" layer="1"/>
<smd name="5" x="-8.5" y="0.0" dx="2.0" dy="1.4" layer="1"/>
<smd name="6" x="-8.5" y="-2.54" dx="2.0" dy="1.4" layer="1"/>
<smd name="7" x="-8.5" y="-5.08" dx="2.0" dy="1.4" layer="1"/>
<smd name="8" x="-8.5" y="-7.62" dx="2.0" dy="1.4" layer="1"/>
<smd name="9" x="-8.5" y="-10.16" dx="2.0" dy="1.4" layer="1"/>
<!-- Right Castellated Pads -->
<smd name="10" x="8.5" y="-10.16" dx="2.0" dy="1.4" layer="1"/>
<smd name="11" x="8.5" y="-7.62" dx="2.0" dy="1.4" layer="1"/>
<smd name="12" x="8.5" y="-5.08" dx="2.0" dy="1.4" layer="1"/>
<smd name="13" x="8.5" y="-2.54" dx="2.0" dy="1.4" layer="1"/>
<smd name="14" x="8.5" y="0.0" dx="2.0" dy="1.4" layer="1"/>
<smd name="15" x="8.5" y="2.54" dx="2.0" dy="1.4" layer="1"/>
<smd name="16" x="8.5" y="5.08" dx="2.0" dy="1.4" layer="1"/>
<smd name="17" x="8.5" y="7.62" dx="2.0" dy="1.4" layer="1"/>
<smd name="18" x="8.5" y="10.16" dx="2.0" dy="1.4" layer="1"/>
<!-- Bottom Castellated Pads -->
<smd name="19" x="-5.08" y="-11.0" dx="1.4" dy="2.0" layer="1"/>
<smd name="20" x="-3.81" y="-11.0" dx="1.4" dy="2.0" layer="1"/>
<smd name="21" x="-2.54" y="-11.0" dx="1.4" dy="2.0" layer="1"/>
<smd name="22" x="-1.27" y="-11.0" dx="1.4" dy="2.0" layer="1"/>
<smd name="23" x="0.0" y="-11.0" dx="1.4" dy="2.0" layer="1"/>
<smd name="24" x="1.27" y="-11.0" dx="1.4" dy="2.0" layer="1"/>
<smd name="25" x="2.54" y="-11.0" dx="1.4" dy="2.0" layer="1"/>
<smd name="26" x="3.81" y="-11.0" dx="1.4" dy="2.0" layer="1"/>
<smd name="27" x="5.08" y="-11.0" dx="1.4" dy="2.0" layer="1"/>
<!-- Extra UART Pads -->
<smd name="43" x="-2.54" y="5.08" dx="1.2" dy="1.2" layer="1"/>
<smd name="44" x="-2.54" y="2.54" dx="1.2" dy="1.2" layer="1"/>
</package>
</packages>

<symbols>
<symbol name="ESP32-S3-ZERO">
<description>&lt;b&gt;Waveshare ESP32-S3-Zero Schematic Symbol&lt;/b&gt;</description>
<wire xval1="-17.78" yval1="38.1" xval2="17.78" yval2="38.1" width="0.254" layer="94"/>
