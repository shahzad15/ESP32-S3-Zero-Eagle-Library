<pin name="GP14" x="-22.86" y="-7.62" length="middle"/>
<pin name="GP15" x="-22.86" y="-10.16" length="middle"/>

<!-- Right GPIO Pins -->
<pin name="GP16" x="22.86" y="25.4" length="middle" rot="R180"/>
<pin name="GP17" x="22.86" y="22.86" length="middle" rot="R180"/>
<pin name="GP18" x="22.86" y="20.32" length="middle" rot="R180"/>
<pin name="GP19/USB_D-" x="22.86" y="17.78" length="middle" rot="R180"/>
<pin name="GP20/USB_D+" x="22.86" y="15.24" length="middle" rot="R180"/>
<pin name="GP21/RGB_LED" x="22.86" y="12.7" length="middle" rot="R180"/>
<pin name="GP38" x="22.86" y="10.16" length="middle" rot="R180"/>
<pin name="GP39" x="22.86" y="7.62" length="middle" rot="R180"/>
<pin name="GP40" x="22.86" y="5.08" length="middle" rot="R180"/>
<pin name="GP43/TXD0" x="22.86" y="0.0" length="middle" rot="R180"/>
<pin name="GP44/RXD0" x="22.86" y="-2.54" length="middle" rot="R180"/>
</symbol>
</symbols>

