<text x="-17.78" y="39.37" size="1.778" layer="95">&gt;NAME</text>
<text x="-17.78" y="-41.91" size="1.778" layer="96">&gt;VALUE</text>

<!-- Power & System Pins -->
<pin name="5V" x="-22.86" y="35.56" length="middle" direction="pwr"/>
<pin name="GND" x="-22.86" y="33.02" length="middle" direction="pwr"/>
<pin name="3V3" x="-22.86" y="30.48" length="middle" direction="pwr"/>

<!-- Left GPIO Pins -->
<pin name="GP1" x="-22.86" y="25.4" length="middle"/>
